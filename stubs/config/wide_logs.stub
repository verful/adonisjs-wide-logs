import { defineConfig } from '@verful/adonisjs-wide-logs'

export default defineConfig({
  http: {
    /**
     * Route params whose values never reach the logged path
     */
    // secretParams: /token|secret|signature|password|key/i,

    /**
     * Fields added to every request's event when it ends, e.g. the tenant
